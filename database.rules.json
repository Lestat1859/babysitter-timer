{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "Iloukia": {
      ".read": "auth != null && (auth.token.email == 'valavaneiloukia@gmail.com' || auth.token.isAdmin == true)",
      ".write": "auth != null && (auth.token.email == 'valavaneiloukia@gmail.com' || auth.token.isAdmin == true)"
    },
    "PriceTimeInterval": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.isAdmin == true"
    },
    "admin": {
      ".read": "auth != null && auth.token.isAdmin == true",
      ".write": "auth != null && auth.token.isAdmin == true"
    },
    "sessions": {
      ".read": "auth != null",
      ".indexOn": [
        "userId"
      ],
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('userId').val() == auth.uid || !data.exists() || auth.token.isAdmin == true)",
        ".validate": "newData.hasChildren(['arrivalDate', 'departureDate', 'duration', 'userId', 'userEmail'])"
      }
    },
    "users": {
      ".read": "auth != null && auth.token.isAdmin == true",
      ".write": "auth != null && auth.token.isAdmin == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.isAdmin == true)",
        ".write": "auth != null && (auth.uid == $uid || auth.token.isAdmin == true)"
      }
    }
  }
}